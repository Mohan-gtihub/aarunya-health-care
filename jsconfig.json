{
    "compilerOptions": {
        "jsx": "react",
        "module": "esnext",
        "target": "es2015",
        "lib": [
            "dom",
            "es2015"
        ],
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "exclude": [
        "node_modules",
        ".next",
        "out"
    ]
}